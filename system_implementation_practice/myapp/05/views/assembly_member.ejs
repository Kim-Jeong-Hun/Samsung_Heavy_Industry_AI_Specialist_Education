<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Document</title>
    </head>
    <body>
        <div>
  <form action="/">
    <input type="text" name="hg_nm"   value="<%= hg_nm %>"   placeholder="이름">
    <input type="text" name="poly_nm" value="<%= poly_nm %>" placeholder="소속">
    <input type="text" name="orig_nm" value="<%= orig_nm %>" placeholder="지역구">
    <button>검색</button>
  </form>
</div>
        <table border="1">
            <tr>
                <td>대수</td>
                <td>이름</td>
                <td>성별</td>
                <td>소속</td>
                <td>지역구</td>
            </tr>
            <% for(let i=0; i<list.length; i++) { %>
                <tr>
                    <td><%= list[i].sch_unit_cd %></td>
                    <td><%= list[i].hg_nm %></td>
                    <td><%= list[i].sex_gbn_nm %></td>
                    <td><%= list[i].poly_nm %></td>
                    <td><%= list[i].orig_nm %></td>
                </tr>
            <% } %>
        </table>
        <%
  const qs = `hg_nm=${encodeURIComponent(hg_nm)}`
           + `&poly_nm=${encodeURIComponent(poly_nm)}`
           + `&orig_nm=${encodeURIComponent(orig_nm)}`;
%>
<% for(let i = startPage; i <= endPage; i++) { %>
  <a href="/?page=<%= i %>&<%- qs %>"><%= i %></a>
<% } %>
    </body>
</html>
