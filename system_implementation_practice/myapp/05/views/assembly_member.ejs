<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Document</title>
    </head>
    <body>
        <div>
            <form>
                <input type="text" name="hg_nm" placeholder="이름">
                <br />
                <input type="text" name="poly_nm" placeholder="소속">
                <br />
                <input type="text" name="orig_nm" placeholder="지역구">
                <br />
                <button>검색</button>
            </form>
        </div>
        <table border="1">
            <tr>
                <td>대수</td>
                <td>이름</td>
                <td>성별</td>
                <td>소속</td>
                <td>지역구</td>
            </tr>
            <% for(let i=0; i<list.length; i++) { %>
                <tr>
                    <td><%= list[i].sch_unit_cd %></td>
                    <td><%= list[i].hg_nm %></td>
                    <td><%= list[i].sex_gbn_nm %></td>
                    <td><%= list[i].poly_nm %></td>
                    <td><%= list[i].orig_nm %></td>
                </tr>
            <% } %>
        </table>
        <% for(let i=startPage; i<=endPage; i++) { %>
            <a href="/?page=<%= i %>"><%= i %></a>
        <% } %>
    </body>
</html>
